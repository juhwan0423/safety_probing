{
  "experiment": "vjepa_frozen_latent_future_v1",
  "comparison_group": "latent-predictive",
  "primary_model_registry_key": "vjepa_2_1",
  "secondary_model_registry_key": "vjepa_2",
  "execution": {
    "hardware_profile": "rtx_5090_local",
    "cpu_offload_allowed": false
  },
  "input": {
    "camera": "main_fixed_northwest",
    "start_time_s": 0.0,
    "end_time_s": 2.375,
    "source_fps": 24,
    "frame_count": 20,
    "sampling": "uniform_inclusive"
  },
  "future_latent_target": {
    "start_time_s": 2.375,
    "end_time_s": 5.0,
    "source_fps": 24,
    "frame_count": 20,
    "sampling": "uniform_inclusive",
    "target_encoder_frozen": true,
    "stop_gradient": true
  },
  "latent_predictor": {
    "trainable": true,
    "layers": 2,
    "heads": 4,
    "model_dim": 512,
    "dropout": 0.1,
    "loss": "cosine_plus_smooth_l1"
  },
  "safety_head": {
    "input": "predicted_future_latents",
    "tasks": [
      "future_tip_over",
      "future_min_outward_zmp_margin_m",
      "pairwise_counterfactual_risk"
    ]
  },
  "training": {
    "encoder_frozen": true,
    "seeds": [17, 29, 43],
    "early_stopping_metric": "validation_pairwise_accuracy"
  }
}
